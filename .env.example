# Copy to .env.development.local for local work. Never commit real values.
# Production values live only in Vercel (Production environment). See docs/environments.md.

# --- Supabase: use the DEVELOPMENT project here, never jpgvclclgnyfguatuihx (production) ---
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe: TEST mode keys only (sk_test_..., pk_test_...) ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# From `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_

# --- Email: outside production, all mail goes here instead of real recipients.
# Leave empty to skip sending entirely.
RESEND_API_KEY=
EMAIL_TEST_RECIPIENT=

# Cron endpoint bearer token (any long random string for local testing)
CRON_SECRET=

# Escape hatch for the environment guard. Leave unset. Setting this to true lets a
# non-production environment use the production database or live Stripe keys.
# ALLOW_PRODUCTION_SERVICES=

# Online checkout is closed unless this is exactly "true" (owner approval required)
CHECKOUT_ENABLED=
